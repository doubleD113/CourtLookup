# Google Maps JavaScript API key (for map view and markers)
# Get one at: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps JavaScript API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID (required for AdvancedMarker)
# Create one at: https://console.cloud.google.com/google/maps-apis/maps
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

# Google Places API key for the data seeding script (server-side only)
# Can be the same key as above if restricted appropriately
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
