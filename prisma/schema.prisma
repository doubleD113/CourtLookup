generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Court {
  id            String    @id @default(uuid())
  name          String
  address       String
  suburb        String
  state         String
  postcode      String
  latitude      Float
  longitude     Float
  facilityType  String    // 'dedicated_court' | 'gym' | 'community_centre'
  surface       String    @default("indoor") // 'indoor' | 'outdoor' | 'both'
  courtCount    Int?
  bookingUrl    String?
  websiteUrl    String?
  phone         String?
  openingHours  Json?
  googlePlaceId String?   @unique
  source        String    // 'google_places' | 'scraper' | 'manual'
  verifiedAt    DateTime?
  surfaceVerifiedAt DateTime?
  hiddenAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  flags         CourtFlag[]
  urlHealth     UrlHealth?

  @@index([suburb])
  @@index([postcode])
  @@index([state])
  @@index([hiddenAt])
  @@map("courts")
}

model UrlHealth {
  id        String   @id @default(uuid())
  courtId   String   @unique
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  url       String
  status    Int      // HTTP status code, or -1 for network error
  errorMsg  String?
  checkedAt DateTime @default(now())

  @@index([status])
  @@map("url_health")
}

model CourtFlag {
  id        String   @id @default(uuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  kind      String   // 'surface' | 'court_existence'
  payload   Json     // surface: { surface: 'indoor'|'outdoor'|'both' }; court_existence: { hasCourt: boolean }
  ipHash    String
  createdAt DateTime @default(now())

  @@unique([courtId, kind, ipHash])
  @@index([courtId])
  @@index([kind])
  @@map("court_flags")
}
