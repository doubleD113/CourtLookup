generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Court {
  id            String    @id @default(uuid())
  name          String
  address       String
  suburb        String
  state         String
  postcode      String
  latitude      Float
  longitude     Float
  facilityType  String    // 'dedicated_court' | 'gym' | 'community_centre'
  surface       String    @default("indoor") // 'indoor' | 'outdoor' | 'both'
  courtCount    Int?
  bookingUrl    String?
  websiteUrl    String?
  phone         String?
  openingHours  Json?
  googlePlaceId String?   @unique
  source        String    // 'google_places' | 'scraper' | 'manual'
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  flags         CourtFlag[]

  @@index([suburb])
  @@index([postcode])
  @@index([state])
  @@map("courts")
}

model CourtFlag {
  id               String   @id @default(uuid())
  courtId          String
  court            Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  suggestedSurface String   // 'indoor' | 'outdoor' | 'both'
  ipHash           String
  createdAt        DateTime @default(now())

  @@unique([courtId, ipHash])
  @@index([courtId])
  @@map("court_flags")
}
